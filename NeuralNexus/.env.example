# ---------------------------------------------------------------------------
# Environment Configuration Template for ProctorIQ
# Copy this file to .env and adjust values for your environment.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) ---
# For Local Dev:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/proctoring_db
# For Docker / Compose:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/proctoring_db

# --- LLM / Agent Configuration ---
LLM_PROVIDER=ollama
# For Local Dev:
# OLLAMA_BASE_URL=http://localhost:11434
# For Docker / Compose:
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# --- App Settings ---
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501

# --- Detection Settings ---
YOLO_WEIGHTS_PATH=yolov8s.pt
YOLO_CONF_THRESHOLD=0.15
FACE_MATCH_THRESHOLD=0.55
